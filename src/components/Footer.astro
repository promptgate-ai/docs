---
import Default from '@astrojs/starlight/components/Footer.astro';
const year = new Date().getFullYear();

const route = Astro.locals.starlightRoute;
const isSplash = route.entry.data.template === 'splash';
const slug = route.id;
const issueUrl = `https://github.com/promptgate-ai/docs/issues/new?title=${encodeURIComponent(`Docs feedback: /${slug}`)}&labels=docs`;
---

{isSplash && (
	<div class="pg-footer pg-footer--splash">
		<div class="pg-footer-row">
			<span>© {year} <a href="https://akyroslabs.com" target="_blank" rel="noopener">Akyros Labs LLC</a>. All rights reserved.</span>
			<span>·</span>
			<span><a href="https://promptgate.dev" target="_blank" rel="noopener">promptgate.dev</a></span>
			<span>·</span>
			<span><a href="https://github.com/promptgate-ai/promptgate" target="_blank" rel="noopener">GitHub</a></span>
		</div>
		<div class="pg-footer-license">
			PromptGate Community Edition is licensed under the Business Source License 1.1.
		</div>
	</div>
)}

{isSplash ? null : null}

{!isSplash && (
	<div class="pg-feedback" data-slug={slug}>
		<div class="pg-feedback-q">Was this page helpful?</div>
		<div class="pg-feedback-actions">
			<button type="button" class="pg-feedback-btn" data-vote="up" aria-label="Helpful">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 14 V7 L8 1 a1 1 0 0 1 1 2 L8 6 H13 a1 1 0 0 1 1 1 L13 13 a2 2 0 0 1 -2 1 H5"/></svg>
				<span>Yes</span>
			</button>
			<button type="button" class="pg-feedback-btn" data-vote="down" aria-label="Not helpful">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M11 2 V9 L8 15 a1 1 0 0 1 -1 -2 L8 10 H3 a1 1 0 0 1 -1 -1 L3 3 a2 2 0 0 1 2 -1 H11"/></svg>
				<span>No</span>
			</button>
			<a class="pg-feedback-issue" href={issueUrl} target="_blank" rel="noopener">Report issue ↗</a>
		</div>
		<div class="pg-feedback-thanks" hidden>Thanks for the feedback!</div>
	</div>
)}

{!isSplash && <Default><slot /></Default>}

{!isSplash && (
	<div class="pg-footer">
		<div class="pg-footer-row">
			<span>© {year} <a href="https://akyroslabs.com" target="_blank" rel="noopener">Akyros Labs LLC</a>. All rights reserved.</span>
			<span>·</span>
			<span><a href="https://promptgate.dev" target="_blank" rel="noopener">promptgate.dev</a></span>
			<span>·</span>
			<span><a href="https://github.com/promptgate-ai/promptgate" target="_blank" rel="noopener">GitHub</a></span>
		</div>
		<div class="pg-footer-license">
			PromptGate Community Edition is licensed under the Business Source License 1.1.
		</div>
	</div>
)}

<script>
	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.pg-feedback-btn');
		if (!btn) return;
		const wrap = btn.closest<HTMLDivElement>('.pg-feedback');
		if (!wrap) return;
		const slug = wrap.dataset.slug ?? '';
		const vote = btn.dataset.vote ?? '';
		try {
			localStorage.setItem(`pg-docs-feedback:${slug}`, vote);
		} catch {}
		wrap.querySelector<HTMLDivElement>('.pg-feedback-actions')!.hidden = true;
		wrap.querySelector<HTMLDivElement>('.pg-feedback-q')!.hidden = true;
		wrap.querySelector<HTMLDivElement>('.pg-feedback-thanks')!.hidden = false;
	});
</script>

<style>
	.pg-footer {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}
	.pg-footer-row {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		align-items: center;
	}
	.pg-footer-row a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.pg-footer-license {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-4);
		font-size: 0.78rem;
	}

	/* On the splash landing we break the footer out of Starlight's
	   60rem content cap so it lines up with the Landing.astro hero
	   width (~1400px on wide screens). */
	.pg-footer--splash {
		width: min(1400px, 96vw);
		margin-inline: calc(50% - min(700px, 48vw));
		margin-top: 1.5rem;
		padding: 1rem 0 0;
	}
	@media (max-width: 1100px) {
		.pg-footer--splash {
			width: 100%;
			margin-inline: 0;
			padding-inline: clamp(16px, 4vw, 32px);
		}
	}

	/* Feedback widget — lives between the content and the pagination. */
	.pg-feedback {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		padding: 14px 16px;
		margin: 24px 0 8px;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		background: var(--sl-color-bg);
		font-size: 13px;
	}
	.pg-feedback-q {
		color: var(--sl-color-gray-2);
		font-weight: 500;
	}
	.pg-feedback-actions {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-left: auto;
	}
	.pg-feedback-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 10px;
		background: transparent;
		color: var(--sl-color-gray-2);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 6px;
		font-family: inherit;
		font-size: 12px;
		cursor: pointer;
		transition: border-color 120ms, color 120ms, background 120ms;
	}
	.pg-feedback-btn:hover {
		border-color: var(--pg-accent);
		color: var(--sl-color-text);
		background: var(--pg-accent-low);
	}
	.pg-feedback-issue {
		font-size: 12px;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		margin-left: 6px;
	}
	.pg-feedback-issue:hover { color: var(--sl-color-text); }
	.pg-feedback-thanks {
		color: var(--pg-accent-ink);
		font-weight: 500;
	}
</style>
